# Flask Config
FLASK_SECRET_KEY=history_voyage_secret_key_13579
FLASK_ENV=development

# NVIDIA NIM API Key (Bắt buộc để chat với nhân vật lịch sử)
# Lấy API key tại https://build.nvidia.com/
NVIDIA_API_KEY=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
# NVIDIA NIM Model (Mặc định: Nemotron 3 Ultra)
# Các model phổ biến: nvidia/nemotron-3-ultra-550b-a55b, meta/llama-3.1-70b-instruct, mistralai/mistral-large
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# NVIDIA NIM Base URL (Chỉ dùng nếu self-hosted NIM)
# NVIDIA_NIM_BASE_URL=https://your-nim-host:port/v1

# FPT.AI hoặc Google Cloud TTS (Tùy chọn - Nếu bỏ trống sẽ tự động fallback sang Web Speech API của trình duyệt - miễn phí và tiếng Việt chuẩn)
FPT_API_KEY=
GOOGLE_TTS_API_KEY=

# D-ID API Key (Tùy chọn - Dùng cho Video avatar mấp máy môi)
DID_API_KEY=
DID_API_USERNAME=
DID_API_PASSWORD=