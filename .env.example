# Flask Config
FLASK_SECRET_KEY=history_voyage_secret_key_13579
FLASK_ENV=development

# NVIDIA NIM API Key (Bắt buộc để chat với nhân vật lịch sử)
# Lấy API key tại https://build.nvidia.com/
NVIDIA_API_KEY=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

# NVIDIA NIM Model (Mặc định: Nemotron 3 Ultra)
# Các model phổ biến: nvidia/nemotron-3-ultra-55b-a55b, meta/llama-3.1-70b-instruct, mistralai/mistral-large
