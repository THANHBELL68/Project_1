# NVIDIA NIM Base URL (Chỉ dùng nếu self-hosted NIM)
# NVIDIA_NIM_BASE_URL=https://your-nim-host:port/v1

# FPT.AI hoặc Google Cloud TTS (Tùy chọn - TTS backend)
